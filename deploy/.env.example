# The production server's .env (/opt/kachabity/.env). Names only: the values live in the GitHub
# secret PROD_ENV, which the deploy workflow writes here. Never commit real values.

# Postgres (the db service). Use letters and digits only in the password (it goes into a URL).
POSTGRES_USER=kachabity
POSTGRES_PASSWORD=
POSTGRES_DB=kachabity

# Sessions (32+ random characters) and the storefront cache refresh (16+), shared by the API and the site.
AUTH_SECRET=
REVALIDATE_SECRET=
# The site on Vercel: links in e-mails, and the cache refresh (same AUTH_SECRET and REVALIDATE_SECRET there).
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_URL=https://example.com

# The API's domain (Caddy) and the S3 buckets: paste terraform output -raw server_env here.
# No S3 keys: the server signs with its instance role.
SITE_DOMAIN=
S3_ENDPOINT=
S3_REGION=
S3_PRODUCTS_BUCKET=
S3_DOCUMENTS_BUCKET=
BACKUP_BUCKET=
FILES_PUBLIC_URL=

# Roles that don't depend on the account.
OWNER_EMAILS=
ADMIN_EMAILS=

# Optional services (leave empty to turn off).
GMAIL_USER=
# Another mailbox than Gmail (e.g. business@kachabiti.com at Hostinger: smtp.hostinger.com); GMAIL_USER / GMAIL_APP_PASSWORD are then its address and password
SMTP_HOST=
# Owner → Colissimo account: your colissimodelivery.tn website login (read-only use)
COLISSIMO_PORTAL_USER=
COLISSIMO_PORTAL_PASSWORD=
GMAIL_APP_PASSWORD=
VAPID_KEYS=
VAPID_SUBJECT=mailto:you@example.com
COLISSIMO_ADD_TOKEN=
COLISSIMO_TRACKING_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Support bot (docs/SUPPORT-BOT.md). META_APP_ID tells our replies apart from Business Suite's.
META_APP_ID=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Bot knowledge searched by meaning too (voyageai.com); optional
VOYAGE_API_KEY=
# Optional tracing (Langfuse Cloud; customer details are masked before sending).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
SENTRY_DSN=
STOCK_API_KEY=
