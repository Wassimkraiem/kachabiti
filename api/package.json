    "@sentry/nestjs": "^11.9.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.2",
    "jose": "^6.2.13",
    "kysely": "^0.29.7",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
